{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5031"
      }
    }
  },
  "ConnectionStrings": {
    "CarPointCloudDb": ""
  },
  "Database": {
    "Enabled": false,
    "CommandTimeoutSeconds": 30,
    "InitializeOnStartup": false
  },
  "PlateAcquisition": {
    "PollIntervalMs": 500,
    "IdleMaxPollIntervalMs": 3000,
    "ProcessingStaleSeconds": 35,
    "DeadlineSeconds": 30,
    "MaxConcurrentJobs": 4,
    "CaptureLeadToleranceSeconds": 5,
    "ClockSkewToleranceSeconds": 5
  },
  "AuditLog": {
    "CaptureBodies": false,
    "CapturePartnerQueryBodies": false,
    "CaptureHeaders": false,
    "RetentionDays": 90,
    "CleanupBatchSize": 1000,
    "WriteTimeoutMs": 2000,
    "MaxBodyChars": 1048576
  },
  "Radar": {
    "BaseUrl": "http://127.0.0.1:8000",
    "AllowedDeviceAddresses": ["127.0.0.1", "::1"],
