    "LicensePlateMockRandom": false
  },
  "RadarLive": {
    "RecorderToken": "",
    "ManualDeviceId": "MANUAL_CONSOLE",
    "ArrivalCameraIdentifier": "CAM004"
  },
  "Integration": {
    "ExternalPartnerEnabled": false,
    "ExternalQueriesEnabled": false,
    "EnableMockLicensePlate": false,
    "AppSecret": "",
    "TimestampToleranceSeconds": 60,
    "RateLimitPerSecond": 3,
    "PartnerBaseUrl": "",
    "LicensePlatePath": "/api/v1/licensePlateRecords",
    "PartnerTimeoutMs": 3000,
    "PartnerRetryCount": 3,
    "PartnerFirstCallDelayMs": 10000,
    "PartnerRetryDelayMs": 5000
  },
  "Auth": {
    "JwtSecret": "",
    "InitialAdminUsername": "admin",
    "InitialAdminPassword": "",
    "TokenExpireMinutes": 480,
    "Issuer": "CarPointCloudWebApi",
    "Audience": "CarPointCloudViewer"
  },
  "EmptyVehicleProfile": {
    "StorageRoot": ""
  },
  "LoadRadar": {
    "Enabled": false
  }
