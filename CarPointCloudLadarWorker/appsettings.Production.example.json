{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\data\\logs\\worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "LadarCapture": {
    "CollectPcdOnly": false,
    "EnableApiRequests": true,
    "EnablePythonAnalyzer": true,
    "LicensePlate": "",
    "FetchLicensePlateOnCapture": true,
    "LicensePlateFetchTimeoutSeconds": 2,
    "CaptureDirectory": "D:\\data\\captures",
    "CaptureRetentionHours": 72,
    "CaptureCleanupIntervalMinutes": 60,
    "CaptureCleanupDailyAt": "03:00",
    "PermanentPointCloudDirectories": [
      "D:/data/empty-vehicle-profiles"
    ],
    "CoordinateScale": 1.0,
    "DualRadarExtrinsicPath": "D:\\data\\calibration\\dual-radar-extrinsic.json",
    "ScanOnceTimeoutSeconds": 40,
    "HealthLogIntervalSeconds": 10,
    "HealthSnapshotDirectory": "D:\\data\\worker-health",
    "AnalyzerTimeoutSeconds": 120,
    "AnalysisTaskDirectory": "",
    "AnalysisRetryCount": 2,
    "AnalysisRetryDelaySeconds": 10,
    "AnalyzerServiceUrl": "http://127.0.0.1:8010",
    "AnalyzerBaselineDirectory": "D:\\data\\baselines",
    "WebApiUrl": "http://localhost:5031",
    "AppSecret": "",
    "EnableHttpApi": true,
    "HttpApiHost": "127.0.0.1",
    "HttpApiPort": 8000,
    "Devices": [
      {
        "RadarModel": "Ladar91",
        "Address": "198.51.100.43",
        "Port": 1112,
        "CameraIdentifier": "CAM_004",
        "MinValidFramePointCount": 5000
      },
      {
        "RadarModel": "Ladar91",
        "Address": "198.51.100.44",
        "Port": 1112,
        "CameraIdentifier": "CAM_005",
        "MinValidFramePointCount": 5000
      }
    ],
    "MaximumFrameDeliveryDelayMilliseconds": null,
    "DiscardCompleteCyclesAfterCommand": 1,
    "EnableLivePreview": true,
    "LivePreviewMaxPointsPerCamera": 12000,
    "LivePreviewPairingWindowSeconds": 7,
    "LivePreviewStaleSeconds": 21,
    "SyntheticFrameIntervalSeconds": 4.04
  }
}
